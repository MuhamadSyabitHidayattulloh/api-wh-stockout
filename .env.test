# Environment Test Configuration
NODE_ENV=test
PORT=7878

# Database Test (gunakan database test yang terpisah)
DB_MASTER_NAME=test_master_db
DB_MASTER_USERNAME=test_user
DB_MASTER_PASSWORD=test_password
DB_MASTER_SERVER=localhost

DB_WH_NAME=test_warehouse_db
DB_WH_USERNAME=test_user
DB_WH_PASSWORD=test_password
DB_WH_SERVER=localhost

DB_STORAGE_NAME=test_storage_db
DB_STORAGE_USERNAME=test_user
DB_STORAGE_PASSWORD=test_password
DB_STORAGE_SERVER=localhost

# Redis Test
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Test
JWT_SECRET=test-secret-key-12345

# Logging Test
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/test/

# API Test
API_VERSION=v1
API_PREFIX=/api